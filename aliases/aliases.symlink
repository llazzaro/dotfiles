# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias tmux="tmux -2"
alias find_big_files="du -a / | sort -n -r | head -n 10"
alias find_images="find . -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.gif' \)"
alias delete_pycs="find . -name \"*.pyc\" -exec rm -rf {} \;"
if [[ "$(uname)" == "Darwin" ]]; then
    alias l='ls -lAh -G'
else
    alias l='ls -lAh --color'
fi
alias 'weather'='curl -4 https://wttr.in/Milan'
alias 'mkdir'='mkdir -p'
alias 'download-music'='yt-dlp -x --audio-quality 0 --audio-format mp3'
# find a string in the git history
alias gitsearch='git rev-list --all | xargs git grep -F'
alias rm="rm -i"
#ban ip
function ban() {
    if [ "`id -u`" == "0" ] ; then
        iptables -A INPUT -s "$1" -j DROP
    else
        sudo iptables -A INPUT -s "$1" -j DROP
    fi
}

# Re-run the last command with sudo, or run a command with sudo.
# WARNING: history-based re-execution can be surprising; review before use.
s(){
    if [[ $# == 0 ]]; then
        sudo $(history -p '!!')
    else
        sudo "$@"
    fi
}

# python simple http server (loopback only; add --bind 0.0.0.0 to expose)
alias servethis="python3 -m http.server --bind 127.0.0.1"

# Get week number
alias week='date +%V'

# URL-encode strings
alias urlencode='python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))"'

#  HTTP headers without fetching the actual content of the page
alias icurl="curl -I"

# Open ports per process
alias open_ports="sudo netstat -tulpn"

alias vlc='open -a vlc'
alias gitx='gittower "$(git rev-parse --show-toplevel)"'
